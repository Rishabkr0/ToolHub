# Environment Variables for ToolHub

# Database Configuration (SQLite default with Better-SQLite3 adapter)
DATABASE_URL="file:./dev.db"

# Better Auth Configuration (if configuring authentication)
# BETTER_AUTH_SECRET=your-secret-key-here
# BETTER_AUTH_URL=http://localhost:3000

# Next.js Public Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing (if cloud uploads are enabled)
# UPLOADTHING_SECRET=
# UPLOADTHING_APP_ID=
